# =============================================================================
# Shang Hai storefronts + order Worker — environment variables
# Copy what you need; never commit real values. No variable here enables real
# (live) payments by itself: see PAYMENTS_LIVE_ENABLED below.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Next.js static export, read at BUILD time)
# -----------------------------------------------------------------------------
# Base URL of the order Worker, without a trailing slash, e.g.
#   https://shang-hai-orders.<your-subdomain>.workers.dev
# EMPTY = DEMO MODE: the storefronts use the local checkout simulator
# ("Demostración — no se realizará ningún cargo"); nothing is charged or sent to
# the restaurant. Set it and rebuild to use Stripe Checkout (test mode) instead.
NEXT_PUBLIC_ORDER_API_BASE_URL=

# -----------------------------------------------------------------------------
# Order Worker (workers/shang-hai-orders)
# Vars live in wrangler.jsonc ("vars"); secrets are set with `wrangler secret put`
# (production) or in workers/shang-hai-orders/.dev.vars (local `wrangler dev`).
# -----------------------------------------------------------------------------

# SECRET. Stripe secret (or restricted) key. While STRIPE_TEST_MODE is "true" only
# test keys (sk_test_... / rk_test_...) are accepted; anything else disables payments.
STRIPE_SECRET_KEY=

# SECRET. Signing secret of the Stripe webhook endpoint (whsec_...). Without it the
# Worker refuses to take payments, because it could not confirm them.
STRIPE_WEBHOOK_SECRET=

# "true" (default): Stripe test mode only. "false" is required for live payments.
STRIPE_TEST_MODE=true

# Live payments need STRIPE_TEST_MODE=false AND this set to "true". It represents the
# restaurant owner's explicit approval and their own Stripe account. Keep "false".
PAYMENTS_LIVE_ENABLED=false

# Exact origins allowed to call the storefront API (scheme + host [+ port], no path),
# comma separated. GitHub Pages origin for this repository: https://wh14-ua.github.io
CORS_ALLOWED_ORIGIN=https://wh14-ua.github.io,http://localhost:3000

# Where Stripe sends the customer back. Placeholders filled by the Worker:
#   {storefront} {orderId} {token}   (Stripe itself fills {CHECKOUT_SESSION_ID})
# Must be https (http only for localhost). The status page reads ?pedido=&t=.
STRIPE_SUCCESS_URL=https://wh14-ua.github.io/mangocat-test/showcase/shang-hai/{storefront}/pedido/estado/?pedido={orderId}&t={token}
STRIPE_CANCEL_URL=https://wh14-ua.github.io/mangocat-test/showcase/shang-hai/{storefront}/pedido/?cancelado=1&pedido={orderId}

# Cloudflare Access protecting the staff panel (/admin and /api/admin/*).
# Team domain, e.g. mangocat.cloudflareaccess.com, and the Access application's
# AUD tag. If either is empty the panel answers 503 (closed), never open.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
