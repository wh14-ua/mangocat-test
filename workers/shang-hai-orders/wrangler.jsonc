{
  // Shang Hai order backend — Cloudflare Worker + D1 + Stripe Checkout (test mode).
  // Secrets are NOT configured here: use `wrangler secret put STRIPE_SECRET_KEY`,
  // `wrangler secret put STRIPE_WEBHOOK_SECRET` and `wrangler secret put TELEGRAM_BOT_TOKEN`
  // (see README.md and .dev.vars.example).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shang-hai-orders",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shang-hai-orders",
      // Replace with the id printed by `wrangler d1 create shang-hai-orders`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Workers Rate Limiting binding (period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "CHECKOUT_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } }
  ],

  // Every minute: stale accept/reject locks, acceptance timeouts and reminders, missed
  // webhooks, pending refunds and Telegram retries (src/cron.ts).
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    // Only Stripe TEST keys (sk_test_/rk_test_) are accepted while this is "true".
    // Live payments additionally need PAYMENTS_LIVE_ENABLED="true" (owner approval).
    "STRIPE_TEST_MODE": "true",
    "PAYMENTS_LIVE_ENABLED": "false",
    // "manual": only payment methods that can be authorised now and captured on acceptance.
    // "per-method": methods without manual capture (e.g. Bizum) are charged at once and
    // refunded automatically if the restaurant rejects the order.
    "STRIPE_CAPTURE_MODE": "manual",
    // Exact origins allowed to call the storefront API (no paths, comma separated).
    "CORS_ALLOWED_ORIGIN": "https://wh14-ua.github.io,http://localhost:3000",
    // Return URLs. Placeholders: {storefront} {orderId} {token} {lang}; Stripe fills {CHECKOUT_SESSION_ID}.
    "STRIPE_SUCCESS_URL": "https://wh14-ua.github.io/mangocat-test/showcase/shang-hai/{storefront}/pedido/estado/?pedido={orderId}&t={token}&lang={lang}",
    "STRIPE_CANCEL_URL": "https://wh14-ua.github.io/mangocat-test/showcase/shang-hai/{storefront}/pedido/?cancelado=1&pedido={orderId}&lang={lang}",
    // Staff panel public URL (used by the "VER PEDIDO" button of Telegram alerts).
    "PANEL_URL": "",
    // WhatsApp Cloud API (primary channel). The token, the app secret and the webhook verify
    // token are SECRETS (wrangler secret put WHATSAPP_ACCESS_TOKEN / WHATSAPP_APP_SECRET /
    // WHATSAPP_WEBHOOK_VERIFY_TOKEN). Sender = phone number id from WhatsApp Manager; recipients =
    // the owner's own WhatsApp numbers (E.164, comma separated), never the sender number itself.
    "WHATSAPP_PHONE_NUMBER_ID": "",
    "WHATSAPP_RECIPIENTS": "",
    "WHATSAPP_API_VERSION": "v26.0",
    "WHATSAPP_TEMPLATE_LANGUAGE": "es",
    "RESTAURANT_NAME": "SHANG HAI",
    // Telegram (alternative channel): chat ids that receive alerts and sign-in codes. Empty = off.
    "TELEGRAM_CHAT_IDS": "",
    // Quick preparation times offered when accepting (any 5–180 min value can also be typed).
    "PREP_TIME_OPTIONS": "15,20,30,45",
    // Reminder after N minutes without a decision; automatic decline (hold released) after M (0 = off).
    "ACCEPTANCE_REMINDER_MINUTES": "4",
    "ACCEPTANCE_TIMEOUT_MINUTES": "30",
    // "all": API + webhook + cron + panel on this Worker. See README for the split deployment.
    "WORKER_ROLE": "all",
    // Cloudflare Access (optional second way into the panel). Empty = Telegram code sign-in only.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
