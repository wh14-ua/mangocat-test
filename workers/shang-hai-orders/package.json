{
  "name": "shang-hai-orders",
  "version": "0.1.0",
  "private": true,
  "description": "Order backend (Cloudflare Worker + D1 + Stripe Checkout) for the Shang Hai storefronts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "build:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply shang-hai-orders --local",
    "db:migrate:remote": "wrangler d1 migrations apply shang-hai-orders --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.155.0"
  }
}
